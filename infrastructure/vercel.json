{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "version": 2,
  "name": "deposafety-frontend",
  "framework": "nextjs",
  "buildCommand": "npm run build",
  "outputDirectory": ".next",
  "installCommand": "npm ci",
  "devCommand": "npm run dev",
  "regions": ["sin1"],
  "env": {
    "NEXT_PUBLIC_API_URL": "@deposafety_api_url",
    "NEXT_PUBLIC_SUPABASE_URL": "@deposafety_supabase_url",
    "NEXT_PUBLIC_SUPABASE_ANON_KEY": "@deposafety_supabase_anon_key"
  },
  "builds": [
    {
      "src": "package.json",
      "use": "@vercel/next"
    }
  ],
  "routes": [
    {
      "src": "/(.*)",
      "dest": "/$1"
    }
  ]
}
