# ============================================
# R2 API CREDENTIALS TEMPLATE
# ============================================
# Copy this file to .env and fill in your credentials
# DO NOT commit .env to git!

# Cloudflare Account
R2_ACCOUNT_ID=your_cloudflare_account_id_here

# R2 API Credentials (from API Token or S3-compatible keys)
R2_ACCESS_KEY_ID=your_r2_access_key_id
R2_SECRET_ACCESS_KEY=your_r2_secret_access_key

# Bucket Configuration
R2_BUCKET_NAME=deposafety-uploads
R2_ENDPOINT=https://${R2_ACCOUNT_ID}.r2.cloudflarestorage.com

# Public Access URL (custom domain or R2.dev)
# Custom domain (recommended): https://files.yourdomain.com
# R2.dev URL: https://pub-your_hash.r2.dev
R2_PUBLIC_URL=https://your_custom_domain_or_r2_dev_url

# Optional: Region (auto-detected if not set)
R2_REGION=auto
