# DepoSafety V2 Blockchain Configuration
# Copy this file to .env and fill in your values

# ============================================
# REQUIRED: Private Keys (for deployment/anchoring)
# ============================================
# WARNING: Never commit the .env file with real keys!
# Generate a new wallet for testing: https://vanity-eth.tk/

# Private key for contract deployment (with 0x prefix)
DEPLOYER_PRIVATE_KEY=0x

# Private key for anchoring evidence (can be same as deployer)
ANCHOR_PRIVATE_KEY=0x

# ============================================
# CONTRACT ADDRESS (fill after deployment)
# ============================================
CONTRACT_ADDRESS=0x

# ============================================
# OPTIONAL: RPC Provider API Keys
# ============================================
# Get free API keys for better reliability:
# Alchemy: https://www.alchemy.com/
# Infura: https://www.infura.io/

ALCHEMY_API_KEY=
INFURA_API_KEY=

# ============================================
# OPTIONAL: Custom RPC URL
# ============================================
# If set, overrides Alchemy/Infura/public RPCs
# CUSTOM_RPC_URL=https://polygon-mumbai.g.alchemy.com/v2/YOUR_KEY
