# DepoSafety V2 - Environment Variables
# Copy this file to .env and fill in your credentials

# App Settings
DEBUG=false
SECRET_KEY=your-super-secret-key-change-in-production

# Supabase Configuration
# Get these from your Supabase project settings
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your-supabase-service-role-key

# Cloudflare R2 Configuration (S3 Compatible)
# Get these from your Cloudflare R2 dashboard
R2_ENDPOINT_URL=https://your-account.r2.cloudflarestorage.com
R2_ACCESS_KEY_ID=your-r2-access-key
R2_SECRET_ACCESS_KEY=your-r2-secret-key
R2_BUCKET_NAME=deposafety-videos
R2_REGION=auto

# Polygon Blockchain Configuration (Mumbai Testnet)
# Get MATIC from the Mumbai faucet: https://mumbaifaucet.com/
POLYGON_RPC_URL=https://rpc-mumbai.maticvigil.com
WALLET_PRIVATE_KEY=your-wallet-private-key-without-0x-prefix
CONTRACT_ADDRESS=your-deployed-contract-address
CHAIN_ID=80001

# SendGrid Configuration
# Get your API key from https://app.sendgrid.com/
SENDGRID_API_KEY=your-sendgrid-api-key
FROM_EMAIL=noreply@deposafety.com

# Webhook Security
WEBHOOK_SECRET=your-webhook-secret-for-verifying-callbacks
